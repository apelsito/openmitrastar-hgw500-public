# The Topaz controller exposes NOR reads through a memory window at 0x90000000.
# Use the upstream ROM mapping so every write/erase operation returns -EROFS.
CONFIG_BLOCK=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_ROM=y
CONFIG_MTD_PHYSMAP=y
CONFIG_MTD_PHYSMAP_OF=y
CONFIG_ARC_BUILTIN_DTB_NAME="topaz_mitrastar_storage"
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
