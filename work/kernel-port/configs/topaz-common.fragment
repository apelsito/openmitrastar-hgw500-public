# Core shared by engineering/release. Hardware features are separate fragments.
CONFIG_LOCALVERSION="-openmitrastar"
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_BINFMT_ELF=y
CONFIG_ISA_ARCOMPACT=y
CONFIG_ARC_CPU_750D=y
CONFIG_ARC_MMU_V2=y
CONFIG_ARC_PAGE_SIZE_8K=y
CONFIG_ARC_CACHE=y
CONFIG_ARC_CACHE_LINE_SHIFT=5
CONFIG_ARC_HAS_ICACHE=y
CONFIG_ARC_HAS_DCACHE=y
CONFIG_ARC_CACHE_PAGES=y
# CONFIG_ARC_CACHE_VIPT_ALIASING is not set
CONFIG_LINUX_LINK_BASE=0x8493a000
CONFIG_LINUX_RAM_BASE=0x8493a000
CONFIG_ARC_BUILTIN_DTB_NAME="topaz_mitrastar_stage0"
CONFIG_QTN_TOPAZ_IRQCHIP=y
# CONFIG_SMP is not set
CONFIG_PREEMPT_NONE=y
CONFIG_HZ=100
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_SLUB=y
# CONFIG_SLOB is not set
CONFIG_MODULES=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_HARDENED_USERCOPY=y
