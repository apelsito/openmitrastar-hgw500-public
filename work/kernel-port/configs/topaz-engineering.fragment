# Lean development image. Deep diagnostics are a separate opt-in overlay.
CONFIG_LOCALVERSION="-openmitrastar-eng"
CONFIG_MODULE_UNLOAD=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KALLSYMS=y
# CONFIG_KALLSYMS_ALL is not set
CONFIG_DEBUG_FS=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FTRACE=y
CONFIG_STACKTRACE=y
CONFIG_DEBUG_INFO=y
CONFIG_SLUB_DEBUG=y
# CONFIG_SLUB_DEBUG_ON is not set
CONFIG_QTN_TOPAZ_MDIO_RO_PROBE=y
CONFIG_QTN_TOPAZ_PCIE_RO_PROBE=y
CONFIG_QTN_TOPAZ_ETHERNET_LAYOUT_TEST=y
CONFIG_NET_VENDOR_QUANTENNA=y
CONFIG_QTN_TOPAZ_EMAC_SKELETON=y
